# ── Application ────────────────────────────────────────────────────────
# development | production. In production the app refuses to start with
# development defaults for SECRET_KEY or a SQLite DATABASE_URL.
ENVIRONMENT=development
DEBUG=false

# ── Security ───────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never commit the real value.
SECRET_KEY=change-me-generate-a-real-one

# JWT signing algorithm. HS256 is fine for a single service.
ALGORITHM=HS256

# How long an access token stays valid, in minutes. Default 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# bcrypt work factor. 12 is a good default; lower it only in tests.
BCRYPT_ROUNDS=12

# ── Database ───────────────────────────────────────────────────────────
# SQLite for local development:
DATABASE_URL=sqlite:///./awaaz.db
# PostgreSQL in production (docker-compose provides this):
# DATABASE_URL=postgresql+psycopg://awaaz:awaaz@db:5432/awaaz

# ── Speech engine ──────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
# tiny is ~75 MB and runs about 2x real-time on one CPU core.
WHISPER_MODEL=tiny

# cpu | cuda
WHISPER_DEVICE=cpu

# int8 (CPU, small memory) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8

# Beam search width. Higher is slightly more accurate and slower.
WHISPER_BEAM_SIZE=5

# Hard cap on a single job, in seconds.
TRANSCRIPTION_TIMEOUT_SECONDS=900

# ── Uploads ────────────────────────────────────────────────────────────
# Maximum accepted file size in megabytes.
MAX_UPLOAD_MB=25

# Where uploaded audio is written. Must be writable by the app user.
UPLOAD_DIR=./uploads

# Comma-separated MIME types accepted on upload. Magic bytes are also
# checked, so this is a first filter rather than the only one.
ALLOWED_AUDIO_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,audio/m4a,audio/x-m4a,audio/ogg,audio/webm,audio/flac,audio/x-flac,video/mp4,video/webm

# ── HTTP ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS. Add your real domain in prod.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Per-IP rate limits (slowapi syntax).
RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=10/minute
